# The one entry port of the live stack (PRD H2). The Cloudflare Tunnel points here, at
# ui:8080 on the stack's own Docker network, so the server publishes no inbound port.
{
	admin off
	auto_https off
}

:8080 {
	encode gzip

	# Headers a browser should enforce on every page JAP serves (IDEA-13).
	#
	# The content security policy is written from what the build actually loads, and the two
	# outside hosts are both Cloudflare's or Google's, not ours:
	#   challenges.cloudflare.com  the Turnstile check on sign-up and forgot password
	#                              (frontend/src/pages/SignInPage.tsx), script and iframe
	#   fonts.googleapis.com       the IBM Plex stylesheet (frontend/index.html)
	#   fonts.gstatic.com          the font files that stylesheet then asks for
	# 'unsafe-inline' is there for styles only, because the pages use React style props and
	# styles.css has data: URLs for the select chevrons; scripts have no such hole.
	# Adding anything to the UI that loads from a new host means adding it here, and the
	# sign-up page is the one to check, since Turnstile is the only third-party script.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Only the Inngest server inside Docker calls /api/inngest (PRD S8), never the tunnel.
	# The longer path sorts first, so this wins over /api/* below. The app the proxy points
	# at does not even mount it (main.py, JAP_ROLE=api); this is the outer lock.
	handle /api/inngest* {
		respond 404
	}

	handle /api/* {
		reverse_proxy app:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
