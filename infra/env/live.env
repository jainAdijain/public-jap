# live (PRD H3, H4): the settings that differ from .env.example.
# infra/scripts/env-create.sh copies .env.example and replaces every key below, then adds a
# fresh database password and Inngest keys, and writes the result to .env.live.
#
# live is the server (README, Hosting): one Linux machine running infra/compose.release.yaml
# behind its own Cloudflare Tunnel. It is the only environment on the internet, the only one
# that submits applications and sends email, and the only one that holds other people's data.
# It shares nothing with local but this repository: its own Docker project, database volume,
# data folder and ports.

# JAP_ENV drives the UI badge: anything but prod shows one (App.tsx), so live has no badge.
JAP_ENV=prod
# Not jap-live: that name, and the ports it had, belong to the private JAP's live stack,
# which runs on the same VM. A shared name would be a shared database volume (decision 31).
# agent-guard.py still matches this one as live.
JAP_PROJECT=public-jap-live
# The file compose injects into the containers (infra/compose.yaml, env_file).
JAP_ENV_FILE=.env.live
# Adds infra/compose.release.yaml: images from GHCR, built UI behind Caddy, Ollama and the
# tunnel in the stack, no source mounts, no Adminer.
JAP_RELEASE=1
JAP_SUBMIT_ENABLED=true

# The images `make deploy` pulls. The tag is the checked-out git tag, not a setting (the
# Makefile reads it from git), so the compose files and the image always match.
JAP_IMAGE_APP=ghcr.io/jainadijain/public-jap-app
JAP_IMAGE_UI=ghcr.io/jainadijain/public-jap-ui

# Ollama is a container here, not the Mac's native one (infra/compose.release.yaml).
OLLAMA_BASE_URL=http://ollama:11434

# Sign-in (PRD S5): the session cookie is Secure and __Host- prefixed only when this is true.
JAP_COOKIE_SECURE=true
# Where reset links and confirmation emails point, and the only origin a write may come from.
JAP_UI_URL=https://jobs.tutorial.monster
CORS_ORIGINS=["https://jobs.tutorial.monster"]

# No AI on JAP's key unless the admin grants it (launch decision D1): each account brings its
# own OpenRouter key, which needs JAP_SECRET_KEY set, or gets credit in Settings > Accounts.
JAP_MONTHLY_COST_CAP_USD=0
# The first week's ceiling across every account (launch plan stage 2); raise it with workers.
JAP_DAILY_APPLICATIONS_TOTAL=50
# Sign-up limits count per visitor (PRD S1). Behind the tunnel every request arrives from
# cloudflared, so the visitor's address is the one Cloudflare puts in this header.
JAP_CLIENT_IP_HEADER=CF-Connecting-IP
JAP_ALERTS_ENABLED=true
INNGEST_DEV=0

# Real resumes, cover letters, screenshots and backups, kept apart from local's scratch copy.
JAP_DATA_HOST_DIR=data-live

# Ports, all on 127.0.0.1, and reachable only over an SSH tunnel to the server. The public
# path is cloudflared inside the stack, which reaches Caddy over the Docker network, so not
# even the UI port has to be published (PRD H2). Adminer has no port: it is not in this
# stack at all (infra/compose.release.yaml).
# Clear of every port in use on the VM (the private JAP's live has 5373/8201/8490/5434).
JAP_UI_PORT=5383
JAP_API_PORT=8211
JAP_INNGEST_PORT=8491
JAP_DB_PORT=5436

# Filled in by hand on the server, once (env-create.sh writes the line empty):
#   TUNNEL_TOKEN      Cloudflare Zero Trust > Networks > Tunnels, this server's own tunnel
#   OPENROUTER_API_KEY, SMTP_PASSWORD
#   SENTRY_DSN        optional; only redacted errors are sent (PRD O15)
TUNNEL_TOKEN=
