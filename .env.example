# Copy to .env (make start does this for you the first time) and fill in the blanks.
# .env is gitignored. Never commit real keys or passwords.

# Which environment this is (PRD H3, H4). This file is the local stack; `make env ENV=live`
# writes .env.live from this file plus infra/env/live.env.
JAP_ENV=dev
# The env file compose injects into the containers. Leave it as .env here; .env.live sets
# itself, so the two stacks never read each other's settings.
JAP_ENV_FILE=.env
# Docker Compose project name: keeps each environment's database volume apart.
JAP_PROJECT=jap
# 1 = built UI behind Caddy, self-hosted Inngest, no Adminer (infra/compose.release.yaml).
JAP_RELEASE=0
# Which half of the app a process is: api (serves /api), worker (runs the Inngest functions
# and the browser) or all (both). Compose sets it per service, so leave this at all; it only
# applies to a process you start by hand.
JAP_ROLE=all
# false = an application is never submitted to a job site from this environment.
JAP_SUBMIT_ENABLED=true

# Postgres in the db container
POSTGRES_USER=jap
POSTGRES_PASSWORD=jap
POSTGRES_DB=jap
DATABASE_URL=postgresql+psycopg://jap:jap@db:5432/jap

# OpenRouter: every chat model call
OPENROUTER_API_KEY=
JAP_MODEL_EXTRACT=openai/gpt-5.6-luna
JAP_MODEL_WRITE=anthropic/claude-sonnet-4.5

# Ollama: embeddings only. Natively on the Mac (outside Docker) so it can use the GPU;
# on the server it is a container in the live stack, at http://ollama:11434.
JAP_MODEL_EMBED=nomic-embed-text
JAP_EMBED_DIM=768
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI spend a month, in USD (PRD S12). Each user's own allowance (they can lower theirs in
# Settings, not raise it), the service's budget for reading shared job postings, and the
# limit on everything together, which is what bounds the OpenRouter bill.
JAP_MONTHLY_COST_CAP_USD=1
JAP_SYSTEM_COST_CAP_USD=5
JAP_TOTAL_COST_CAP_USD=20
# The free plan: companies one account may follow, and applications it may send a day.
# The admin account is not held to either, and can set any one account's own numbers in
# Settings > Accounts. The allowance above goes with them: an application costs about 2 to
# 3 cents of AI, so one a day is under $1 a month.
JAP_FREE_BOARDS=1
JAP_FREE_DAILY_APPLICATIONS=1

# The mailbox JAP sends from (confirmation and alert emails go to the address on My profile).
# GoDaddy Professional Email: smtpout.secureserver.net, 465, SSL, your full address and its password.
# Gmail instead: SMTP_HOST=smtp.gmail.com and an app password (needs 2-Step Verification).
# A local test mailbox would use SMTP_PORT=1025, SMTP_SSL=false.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
# The same mailbox read over IMAP for a security code Greenhouse emails (PRD A5). A Gmail
# filter forwards those emails here. Gmail instead: IMAP_HOST=imap.gmail.com.
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_SSL=true

# Where JAP's emails link back to: the job in JAP, and password reset links
JAP_UI_URL=http://localhost:5173

# Sign-in (PRD S1 to S5). JAP_COOKIE_SECURE=true wherever JAP is served over HTTPS.
# JAP_ADMIN_EMAIL, when set, is the only address that can create the first (admin) account.
JAP_COOKIE_SECURE=false
JAP_ADMIN_EMAIL=
JAP_SESSION_IDLE_DAYS=7
JAP_SESSION_MAX_DAYS=30

# Sign-up (PRD S1, S10): anyone can create an account and confirms the address by an emailed
# link. Tries allowed in an hour from one address, and for one email, on sign-up, forgot
# password and "send the link again".
JAP_AUTH_TRIES_PER_HOUR_IP=20
JAP_AUTH_TRIES_PER_HOUR_EMAIL=5
# The header a trusted proxy puts the visitor's address in: CF-Connecting-IP behind the
# Cloudflare Tunnel. Empty = the connection's own address. Set it only behind a proxy that
# overwrites the header, or anyone can claim any address.
JAP_CLIENT_IP_HEADER=
# Cloudflare Turnstile ("prove you're human") on sign-up and forgot password: the site key
# the page shows and the secret key the server checks with. Both empty = no check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inngest: the dev server here; test and prod run a self-hosted server with their own keys
# (make env-create generates both).
INNGEST_DEV=1
INNGEST_BASE_URL=http://inngest:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Logging, Status and alerts (PRD 1.19). JAP_ENV names this environment on log lines,
# alert subjects and Sentry. LOG_JSON=false prints plain lines instead of JSON.
JAP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
# Health alert emails (Daily search missed, stuck search, error bursts, AI spend, disk).
JAP_ALERTS_ENABLED=true
JAP_ALERT_ERRORS_PER_HOUR=10
# Sentry's free Developer plan: paste the project's DSN to send redacted errors. Empty = off.
SENTRY_DSN=

# Sign in with Google. All three empty (the default) means the button is not shown and the
# routes answer Not Found, so a fresh clone and make test need nothing from Google. Make an
# OAuth client at console.cloud.google.com, type Web application, and give it the redirect
# URL below exactly, which must be the address you open JAP at plus /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# How many searches run at once across the service. Each account is held to one of their
# own whatever this is, so it is the number of different people who can search at the same
# time; the rest wait their turn. Raise it only after watching what gives first (Postgres,
# Ollama's embedding, the OpenRouter budget).
JAP_MAX_PARALLEL_RUNS=3

# How long a company's jobs count as fresh. Two people who follow the same company and
# search within this many minutes share one fetch instead of asking the job board twice.
# A description nobody had asked for yet is still read on the second search.
JAP_BOARD_FRESH_MINUTES=10

# Time zone each account's daily search runs in, unless they set their own in Settings
JAP_TZ=Asia/Kolkata

# How long the files an application leaves behind are kept, in days (pipeline/retention.py).
# A Playwright trace is megabytes and only useful while a recent failure is being looked
# into; a screenshot is small and is the only evidence of what was sent to an employer.
# 0 keeps them for ever. Resumes and cover letters are never deleted by age.
JAP_KEEP_TRACES_DAYS=30
JAP_KEEP_SCREENSHOTS_DAYS=180

# Ports on your Mac (127.0.0.1 only). Change one if another project already uses it.
# API and Inngest default to 8001 and 8290 so they don't clash with other apps on 8000 and 8288-8289
# (an Inngest dev server publishes both).
JAP_UI_PORT=5173
JAP_API_PORT=8001
JAP_INNGEST_PORT=8290
JAP_DB_PORT=5432
JAP_ADMINER_PORT=8080
