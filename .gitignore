# Secrets
.env
.env.*
!.env.example

# Runtime data (resumes, screenshots, cover letters, backups). data/ is the local stack's,
# data-live/ is the live stack's (JAP_DATA_HOST_DIR).
data/*
!data/.gitkeep
data-live/

# docs/ holds the tracked, public project docs (*.md, docs/README.md). The product documents
# (PRD, build plan, engineering design doc) carry personal data, so they stay on the Mac in
# docs/private/; PDFs and their text extraction are ignored wherever they sit in docs/.
docs/private/
docs/text/
docs/**/*.pdf

# Local notes for this machine (NOTES.local.md): never committed, this repo is public.
NOTES.local.md

# Coding agents: the shared config is tracked (.devin/config.json, .claude/settings.json,
# .gemini/settings.json, .cursorignore); each person's overrides and session files are not.
AGENTS.local.md
CLAUDE.local.md
.devin/*.local.json
.claude/*.local.json
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# OS / editors
.DS_Store
.idea/
.vscode/
